# =============================================================================
# Payra — environment template
# =============================================================================
# 1. Copy this file to `.env` in the SAME folder as README.md (repo root):
#      cp .env.example .env          # macOS / Linux
#      copy .env.example .env        # Windows CMD
#
# 2. Replace the placeholders with your team's live Supabase keys
#    (Dashboard → Project Settings → API), OR unpack the private zip your
#    teammate sent (it should contain a ready-made `.env`).
#
# 3. NEVER commit `.env` — it is gitignored. Never put service_role here.
#
# Without a valid SUPABASE_URL + SUPABASE_ANON_KEY the app runs in DEMO /
# LOCAL mode (fake chats like "Alex Johnson") and will NOT create users in
# Supabase. That is the usual cause of "old test users" after git pull.
# =============================================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional — Phase 3 AI
# GROQ_API_KEY=
# GEMINI_API_KEY=
