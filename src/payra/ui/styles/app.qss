/* Payra — ChatFlow-accurate soft messenger theme */

QWidget {
    font-family: "Avenir Next", "Segoe UI", "Helvetica Neue", sans-serif;
    color: #1C1730;
    background: transparent;
}

QMainWindow, #Root {
    background: #F0EEF6;
}

/* ----- Floating cards (separate panels) ----- */
#NavSidebar,
#ChatListPanel,
#ChatPane,
#DetailPanel {
    background: #FFFFFF;
    border-radius: 24px;
    border: 1px solid rgba(123, 97, 255, 0.06);
}

#MessageArea {
    background: #F5F4FA;
    border-radius: 18px;
}

#ChatHeaderBar {
    background: transparent;
}

/* ----- Brand / nav ----- */
#BrandLabel {
    font-size: 22px;
    font-weight: 700;
    color: #1C1730;
    letter-spacing: -0.3px;
}

#BrandMark {
    background: transparent;
    border: none;
    border-radius: 10px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
}

#NewChatButton {
    background: #7B61FF;
    color: #FFFFFF;
    border: none;
    border-radius: 18px;
    padding: 14px 18px;
    font-size: 14px;
    font-weight: 600;
}

#NewChatButton:hover {
    background: #6A4FF0;
}

#NewChatButton:pressed {
    background: #5B42E0;
}

/* Active nav = soft lavender pill (ChatFlow), not solid purple */
QFrame#NavItemRow {
    background: transparent;
    border: none;
    border-radius: 16px;
}

QFrame#NavItemRow:hover {
    background: #F7F5FB;
}

QFrame#NavItemRow[active="true"] {
    background: #EDE8FF;
}

#NavItemLabel {
    font-size: 14px;
    font-weight: 550;
    color: #8B849C;
    background: transparent;
}

QFrame#NavItemRow[active="true"] #NavItemLabel {
    color: #7B61FF;
    font-weight: 650;
}

#YouRow {
    background: #F7F5FB;
    border-radius: 16px;
}

#YouRow:hover {
    background: #EDE8FF;
}

#YouName {
    font-size: 13px;
    font-weight: 700;
    color: #1C1730;
    background: transparent;
}

#YouStatus {
    font-size: 11px;
    color: #22C55E;
    font-weight: 500;
    background: transparent;
}

#NavMascot {
    background: transparent;
    padding: 0;
    margin: 0;
}

/* Legacy toolbutton nav (unused) */
QToolButton[class="NavItem"] {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 11px 14px;
    color: #8B849C;
    font-size: 14px;
    font-weight: 550;
    text-align: left;
}

QToolButton[class="NavItem"]:hover {
    background: #F3F0FF;
    color: #1C1730;
}

QToolButton[class="NavItem"][active="true"] {
    background: #EDE8FF;
    color: #7B61FF;
    font-weight: 600;
}

/* ----- Search ----- */
#SearchField {
    background: #F0EEF6;
    border: none;
    border-radius: 16px;
    padding: 13px 16px;
    font-size: 13px;
    color: #1C1730;
    selection-background-color: #EDE8FF;
}

#SearchField:focus {
    background: #EDE8FF;
}

#SectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #1C1730;
}

/* ----- Chat list rows ----- */
QFrame[class="ChatRow"] {
    background: transparent;
    border-radius: 18px;
}

QFrame[class="ChatRow"]:hover {
    background: #F7F5FB;
}

QFrame[class="ChatRow"][selected="true"] {
    background: #EDE8FF;
}

#ChatRowName {
    font-size: 14px;
    font-weight: 650;
    color: #1C1730;
    background: transparent;
}

#ChatRowPreview {
    font-size: 12px;
    color: #8B849C;
    background: transparent;
}

#ChatRowTime {
    font-size: 11px;
    color: #8B849C;
    background: transparent;
    padding: 0;
    margin: 0;
}

#UnreadBadge {
    background: #7B61FF;
    color: #FFFFFF;
    border: none;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

/* White card kebab (vertical ···) */
#HeaderMenuButton {
    background: #FFFFFF;
    border: none;
    border-radius: 12px;
}

#ChatHeaderMenu {
    background: #FFFFFF;
    border: 1px solid #EEEAF5;
    border-radius: 12px;
    padding: 6px;
}

#ChatHeaderMenu::item {
    padding: 10px 18px;
    border-radius: 8px;
    color: #1C1730;
    font-size: 13px;
}

#ChatHeaderMenu::item:selected {
    background: #EDE8FF;
    color: #7B61FF;
}

/* ----- Header icon buttons ----- */
QToolButton[class="IconRound"] {
    background: #F3F0FF;
    border: none;
    border-radius: 14px;
    color: #7B61FF;
    padding: 8px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    font-size: 15px;
}

QToolButton[class="IconRound"]:hover {
    background: #EDE8FF;
}

QToolButton[class="IconRound"]:disabled {
    color: #C5C0D0;
    background: #F5F4FA;
}

QToolButton[class="IconGhost"] {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #8B849C;
    padding: 8px;
}

QToolButton[class="IconGhost"]:hover {
    background: #F3F0FF;
    color: #7B61FF;
}

/* ----- Chat header / composer ----- */
#ChatHeaderName {
    font-size: 16px;
    font-weight: 700;
}

#ChatHeaderStatus {
    font-size: 12px;
    color: #22C55E;
    font-weight: 500;
}

#ComposerBar {
    background: #FFFFFF;
    border: 1px solid #EEEAF5;
    border-radius: 22px;
}

#ComposerInputWrap {
    background: #F5F4FA;
    border: none;
    border-radius: 18px;
}

#ComposerInput {
    background: transparent;
    border: none;
    font-size: 14px;
    padding: 6px 2px;
    color: #1C1730;
}

#EmojiButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #8B849C;
    font-size: 20px;
    min-width: 32px;
    min-height: 32px;
    padding: 2px;
}

#EmojiButton:hover {
    background: #EDE8FF;
    color: #7B61FF;
}

#EmojiPicker {
    background: #FFFFFF;
    border: 1px solid #EEEAF5;
    border-radius: 16px;
}

#SendButton {
    background: #7B61FF;
    border: none;
    border-radius: 20px;
    min-width: 42px;
    min-height: 42px;
    max-width: 42px;
    max-height: 42px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

#SendButton:hover {
    background: #6A4FF0;
}

#AttachButton {
    background: #7B61FF;
    border: none;
    border-radius: 16px;
    min-width: 38px;
    min-height: 38px;
    max-width: 38px;
    max-height: 38px;
    color: #FFFFFF;
    font-size: 14px;
}

#AttachButton:hover {
    background: #6A4FF0;
}

/* ----- Bubbles (fill is painted in code; keep labels clean) ----- */
#DateChip {
    background: rgba(255, 255, 255, 0.95);
    color: #8B849C;
    border-radius: 12px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}

/* ----- Detail panel ----- */
#DetailName {
    font-size: 18px;
    font-weight: 700;
}

#DetailAbout {
    font-size: 13px;
    color: #8B849C;
    line-height: 1.4;
}

#LinkAccent {
    color: #7B61FF;
    font-size: 12px;
    font-weight: 600;
}

#DangerLink {
    color: #E11D48;
    font-size: 13px;
    font-weight: 600;
}

#MemberMoreChip {
    background: #EDE8FF;
    color: #7B61FF;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
}

#WhiteCardButton {
    background: transparent;
    border: none;
}

#CloseDetailButton {
    background: #FFFFFF;
    border: none;
    border-radius: 12px;
    color: #7B61FF;
    min-width: 40px;
    min-height: 40px;
    font-size: 14px;
    font-weight: 700;
}

#CloseDetailButton:hover {
    background: #F7F5FB;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea#MessageScroll {
    background: #F5F4FA;
    border-radius: 18px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #D8D2E6;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ----- Dialogs (always light / white) ----- */
QDialog#PayraDialog,
QDialog {
    background: #FFFFFF;
    color: #1C1730;
}

#DialogTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1C1730;
    background: transparent;
}

#DialogBody {
    background: #FFFFFF;
}

#DialogScroll {
    background: #FFFFFF;
    border: none;
}

#DialogMuted {
    color: #8B849C;
    font-size: 12px;
    background: transparent;
}

#DialogRowTitle {
    font-size: 14px;
    font-weight: 650;
    color: #1C1730;
    background: transparent;
}

#DialogListRow {
    background: #F7F5FB;
    border-radius: 14px;
    border: 2px solid transparent;
}

#DialogListRow:hover {
    background: #EDE8FF;
}

#DialogListRow[selected="true"] {
    background: #EDE8FF;
    border: 2px solid #7B61FF;
}

#DialogSearch {
    background: #F0EEF6;
    border: 1px solid #E4DFF2;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 14px;
    color: #1C1730;
    selection-background-color: #EDE8FF;
}

#DialogSearch:focus {
    border: 1px solid #7B61FF;
    background: #FFFFFF;
}

#DialogSearch::placeholder {
    color: #9A93A8;
}

QCheckBox#DialogCheck {
    spacing: 8px;
    color: #1C1730;
}

QCheckBox#DialogCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid #C8C0D8;
    background: #FFFFFF;
}

QCheckBox#DialogCheck::indicator:checked {
    background: #7B61FF;
    border: 2px solid #7B61FF;
}

QDialogButtonBox {
    background: transparent;
}

QPushButton#DialogPrimaryButton {
    background: #7B61FF;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: 650;
    font-size: 13px;
    min-width: 88px;
}

QPushButton#DialogPrimaryButton:hover {
    background: #6A4FF0;
}

QPushButton#DialogGhostButton {
    background: #F0EEF6;
    color: #1C1730;
    border: none;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13px;
    min-width: 88px;
}

QPushButton#DialogGhostButton:hover {
    background: #EDE8FF;
    color: #7B61FF;
}

QMessageBox {
    background: #FFFFFF;
    color: #1C1730;
}

QMessageBox QLabel {
    color: #1C1730;
    font-size: 13px;
}

QPushButton#DialogDangerButton {
    background: #FEE2E2;
    color: #E11D48;
    border: none;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: 650;
    font-size: 13px;
    min-width: 88px;
}

QPushButton#DialogDangerButton:hover {
    background: #FECACA;
}

/* ----- Auth (login / register) ----- */
#AuthWindow {
    background: #F0EEF6;
}

#AuthBrandPanel {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #7B61FF,
        stop:1 #9B7BFF
    );
    border-radius: 28px;
}

#AuthBrandMark {
    background: transparent;
    border: none;
    border-radius: 20px;
    min-width: 88px;
    max-width: 88px;
    min-height: 88px;
    max-height: 88px;
    padding: 0;
}

#AuthFormBrandMark {
    background: transparent;
    border: none;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 0;
}

#AuthFormBrandName {
    font-size: 22px;
    font-weight: 750;
    color: #1C1730;
    background: transparent;
}

#AuthBrandTitle {
    color: #FFFFFF;
    font-size: 48px;
    font-weight: 800;
    background: transparent;
}

#AuthBrandTagline {
    color: rgba(255, 255, 255, 0.88);
    font-size: 15px;
    line-height: 1.4;
    background: transparent;
}

#AuthBrandNote {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
    background: transparent;
}

#AuthFormCard {
    background: #FFFFFF;
    border-radius: 28px;
}

#AuthHeading {
    font-size: 26px;
    font-weight: 750;
    color: #1C1730;
    background: transparent;
}

#AuthSubheading {
    color: #8B849C;
    font-size: 13px;
    background: transparent;
}

#AuthInput {
    background: #F0EEF6;
    border: 1px solid #E4DFF2;
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 14px;
    color: #1C1730;
    selection-background-color: #EDE8FF;
}

#AuthInput:focus {
    border: 1px solid #7B61FF;
    background: #FFFFFF;
}

#AuthInput::placeholder {
    color: #9A93A8;
}

#AuthError {
    color: #E11D48;
    font-size: 12px;
    background: transparent;
}

QPushButton#AuthPrimaryButton {
    background: #7B61FF;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    padding: 12px 18px;
    font-weight: 700;
    font-size: 14px;
}

QPushButton#AuthPrimaryButton:hover {
    background: #6A4FF0;
}

QPushButton#AuthLinkButton {
    background: transparent;
    color: #7B61FF;
    border: none;
    padding: 8px;
    font-weight: 600;
    font-size: 13px;
    text-align: left;
}

QPushButton#AuthLinkButton:hover {
    color: #6A4FF0;
}
